    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SIGame\SIGame\SIGame.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\SIGame\SIGame\webtable\**\*">
